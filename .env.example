# ─── Segurança ────────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-seguro

# ─── Banco de dados ───────────────────────────────────────────────────────────
# PostgreSQL incluso via docker-compose
DATABASE_URL=postgresql+psycopg://ticontrol:SENHA_POSTGRES@postgres:5432/ticontrol_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5000
APP_PORT=5000
FLASK_DEBUG=0
SESSION_SECURE=0
# Nunca ativar em produção
SHOW_DEMO_CREDENTIALS=0
AUTO_SEED_DEMO=0
SERVICE_NAME=ti-control-sre
BUILD_VERSION=dev
ENVIRONMENT=development

# Token temporário para liberar /setup na primeira instalação.
# O script install-linux.sh/install-windows.ps1 gera esse valor automaticamente.
SETUP_TOKEN=troque-por-um-token-seguro

# ─── Gunicorn ────────────────────────────────────────────────────────────────
WEB_CONCURRENCY=2
WEB_THREADS=4
GUNICORN_TIMEOUT=60

# ─── Métricas Prometheus ──────────────────────────────────────────────────────
# Token Bearer para proteger /metrics sem autenticação de sessão
# Deixe vazio para exigir login de Administrador
METRICS_TOKEN=

# ─── E-mail SMTP opcional ────────────────────────────────────────────────────
# Também é possível configurar e ativar o SMTP pela própria aplicação em:
# Configurações > E-mail.
# Use estas variáveis apenas se preferir administrar SMTP pelo arquivo de ambiente.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=ti@suaempresa.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM_NAME=TI Suaempresa
SMTP_FROM_EMAIL=noreply@suaempresa.com
SMTP_ENABLED=0

# ─── PostgreSQL (para docker-compose) ────────────────────────────────────────
POSTGRES_DB=ticontrol_db
POSTGRES_USER=ticontrol
POSTGRES_PASSWORD=senha-segura-postgres
POSTGRES_PORT=5432
